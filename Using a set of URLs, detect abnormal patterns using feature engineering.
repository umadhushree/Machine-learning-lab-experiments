import re
import pandas as pd
import matplotlib.pyplot as plt
from urllib.parse import urlparse
from sklearn.ensemble import IsolationForest

# 1. Sample URL dataset
urls = [
    "https://www.google.com",
    "https://www.wikipedia.org",
    "https://www.microsoft.com",
    "https://www.amazon.com",
    "https://www.python.org",
    "https://www.github.com",
    "https://www.apple.com",
    "https://www.nasa.gov",
    "https://www.bbc.com",
    "https://www.example.com/about",
    "http://192.0.2.10/login",
    "http://secure-account-verify.example.net/login",
    "http://free-prize-claim.example.org/win",
    "http://paypal-security-check.example.com/update",
    "http://user@malicious.example.net/login",
    "http://example.com/../../admin",
    "http://login-verify-account-password.example.org",
    "http://198.51.100.25/download/file.exe",
    "http://bonus-reward-claim.example.net",
    "http://example.org/?id=123&redirect=http://evil.example"
]

# 2. Feature engineering
def extract_features(url):
    parsed = urlparse(url)
    hostname = parsed.hostname or ""
    path = parsed.path or ""
    query = parsed.query or ""
    lower_url = url.lower()

    suspicious_keywords = [
        "login", "verify", "secure", "account",
        "password", "free", "bonus", "claim",
        "update", "redirect", "admin", "download"
    ]

    return {
        "url_length": len(url),
        "hostname_length": len(hostname),
        "path_length": len(path),
        "dot_count": url.count("."),
        "hyphen_count": url.count("-"),
        "slash_count": url.count("/"),
        "digit_count": sum(c.isdigit() for c in url),
        "special_char_count": sum(
            not c.isalnum() for c in url
        ),
        "uses_https": int(parsed.scheme == "https"),
        "has_ip_address": int(bool(re.fullmatch(
            r"(?:\d{1,3}\.){3}\d{1,3}", hostname
        ))),
        "has_at_symbol": int("@" in url),
        "has_query": int(bool(query)),
        "query_length": len(query),
        "suspicious_keyword_count": sum(
            keyword in lower_url
            for keyword in suspicious_keywords
        ),
        "has_executable_file": int(
            path.lower().endswith((".exe", ".bat", ".scr", ".msi"))
        ),
        "has_path_traversal": int(".." in path)
    }

# 3. Create feature dataset
features = pd.DataFrame([
    extract_features(url) for url in urls
])

features.insert(0, "URL", urls)

print("=== EXTRACTED URL FEATURES ===")
print(features.to_string(index=False))

# 4. Prepare data for anomaly detection
X = features.drop(columns=["URL"])

# 5. Train Isolation Forest
model = IsolationForest(
    n_estimators=100,
    contamination=0.20,
    random_state=42
)

model.fit(X)

# 6. Detect abnormal URL patterns
features["Anomaly_Score"] = model.decision_function(X)
features["Prediction"] = model.predict(X)

features["Status"] = features["Prediction"].map({
    1: "Normal",
    -1: "Abnormal / Suspicious"
})

# 7. Display results
print("\n=== URL ANOMALY DETECTION RESULTS ===")

print(features[
    ["URL", "Anomaly_Score", "Status"]
].sort_values("Anomaly_Score").to_string(index=False))

# 8. Display suspicious URLs
suspicious = features[
    features["Prediction"] == -1
]

print("\n=== POTENTIALLY SUSPICIOUS URLS ===")

if not suspicious.empty:
    for url in suspicious["URL"]:
        print(url)
else:
    print("No abnormal URL patterns detected.")

# 9. Visualize anomaly scores
plot_data = features.sort_values("Anomaly_Score")

plt.figure(figsize=(12, 6))

colors = [
    "red" if prediction == -1 else "green"
    for prediction in plot_data["Prediction"]
]

plt.bar(
    range(len(plot_data)),
    plot_data["Anomaly_Score"],
    color=colors
)

plt.axhline(0, linestyle="--", color="black")
plt.xticks(
    range(len(plot_data)),
    [f"URL {i+1}" for i in range(len(plot_data))],
    rotation=45
)

plt.title("URL Anomaly Detection Using Isolation Forest")
plt.xlabel("URL Index")
plt.ylabel("Anomaly Score")
plt.tight_layout()
plt.show()

print("\n=== FINAL RESULT ===")
print("URL feature engineering and anomaly detection completed.")
print("Red bars indicate URLs flagged as anomalous.")
print("Green bars indicate URLs not flagged as anomalous.")
